<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#15171A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Climate Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Climate Control"
            android:textColor="@color/glass_text_primary"
            android:textSize="28sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginBottom="16dp"/>

        <!-- Temp Controller Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_temp_down"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/glass_button_ripple"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:rotation="45"
                android:tint="@color/glass_text_primary"
                android:elevation="4dp"/>

            <TextView
                android:id="@+id/txt_temperature"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="72°F"
                android:textColor="@color/glass_accent"
                android:textSize="72sp"
                android:fontFamily="sans-serif-thin"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"/>

            <ImageButton
                android:id="@+id/btn_temp_up"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/glass_button_ripple"
                android:src="@android:drawable/ic_menu_add"
                android:tint="@color/glass_text_primary"
                android:elevation="4dp"/>
        </LinearLayout>

        <!-- AC Toggle / Fan Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="32dp">

            <Button
                android:id="@+id/btn_ac_toggle"
                android:layout_width="140dp"
                android:layout_height="64dp"
                android:text="A/C ON"
                android:textSize="20sp"
                android:background="@drawable/glass_button_active_bg"
                android:textColor="@color/glass_accent"
                android:fontFamily="sans-serif-medium"
                android:layout_marginRight="24dp"/>

            <Button
                android:id="@+id/btn_auto_toggle"
                android:layout_width="140dp"
                android:layout_height="64dp"
                android:text="AUTO"
                android:textSize="20sp"
                android:background="@drawable/glass_button_ripple"
                android:textColor="@color/glass_text_primary"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
