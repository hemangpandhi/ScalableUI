<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:background="@drawable/floating_decor_bg"
    android:padding="24dp">

    <!-- Top Bar: Weather Widget -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/weather_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_weather_cloudy" />

        <TextView
            android:id="@+id/weather_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="22°C  |  Partly Cloudy"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:shadowDx="0"
            android:shadowDy="2" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/weather_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="San Francisco"
            android:textColor="#BBBBBB"
            android:textSize="16sp"
            android:shadowColor="#80000000"
            android:shadowRadius="2"
            android:shadowDx="0"
            android:shadowDy="1" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Main Content: Media Hub -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Album Cover -->
        <ImageView
            android:id="@+id/media_album_art"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/album_cover_rhythm"
            android:scaleType="centerCrop"
            android:background="@drawable/rounded_album_bg"
            android:clipToOutline="true"
            android:elevation="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Song Info -->
        <TextView
            android:id="@+id/media_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RHYTHM IS A DANCER"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:shadowDx="0"
            android:shadowDy="2"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/media_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SNAP!"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#40000000"
            android:shadowRadius="2"
            android:shadowDx="0"
            android:shadowDy="1"
            android:layout_marginBottom="16dp"/>

        <!-- Playback Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/media_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_media_prev"
                android:alpha="0.8"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:id="@+id/media_play_pause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_media_play"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:id="@+id/media_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_media_next"
                android:clickable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:alpha="0.8"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
