<?xml version="1.0" encoding="utf-8"?>
<TaskPanel id="hvac_control_panel" defaultVariant="@id/hvac_hidden" role="hvac_control_panel" displayId="0">
    <Variant id="@+id/hvac_hidden">
        <Layer layer="4"/>
        <Visibility isVisible="false"/>
        <Alpha alpha="0.0"/>
        <Corner radius="48dp"/>
        <!-- Hidden below the bottom dock -->
        <Bounds left="17dp" top="750dp" right="410dp" bottom="900dp"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/hvac_expanded">
        <Layer layer="4"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="48dp"/>
        <!-- Floating over the media/map area -->
        <Bounds left="17dp" top="400dp" right="410dp" bottom="696dp"/>
        <Focus onTransition="true"/>
    </Variant>

    <Transitions>
        <Transition onEvent="show_hvac" fromVariant="@id/hvac_hidden" toVariant="@id/hvac_expanded" duration="500" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="hide_hvac" fromVariant="@id/hvac_expanded" toVariant="@id/hvac_hidden" duration="400" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/hvac_expanded" toVariant="@id/hvac_hidden" duration="400" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="show_two_panel" fromVariant="@id/hvac_expanded" toVariant="@id/hvac_hidden" duration="400" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="show_page2" fromVariant="@id/hvac_expanded" toVariant="@id/hvac_hidden" duration="400" interpolator="@anim/pleos_fluid_interpolator"/>
    </Transitions>
</TaskPanel>
