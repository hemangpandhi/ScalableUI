          package="com.android.car.mockwidgets">

    <uses-sdk android:minSdkVersion="35" android:targetSdkVersion="35" />

    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />

    <application android:label="MockWidgets"
                 android:theme="@style/Theme.MockWidgets">

        <!-- Shared scalable-UI activity attributes for multi-window panel hosting -->
        <!-- resizeableActivity + configChanges prevent black-box / restart during panel transitions -->

        <activity
            android:name=".MockMediaActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:excludeFromRecents="true">
            <meta-data android:name="distractionOptimized" android:value="true"/>
        </activity>

