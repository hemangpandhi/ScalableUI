<TaskPanel id="climate_widget" defaultVariant="@id/base" role="@string/mockwidgets_climate_activity_componentName" displayId="0">
    <Variant id="@+id/base">
        <Layer layer="9"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Bounds left="@dimen/climate_widget_base_left" top="@dimen/climate_widget_base_top" right="@dimen/climate_widget_base_right" bottom="@dimen/climate_widget_base_bottom"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/climate_on_screen">
        <Layer layer="9"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Bounds left="@dimen/climate_widget_climate_on_screen_left" top="@dimen/climate_widget_climate_on_screen_top" right="@dimen/climate_widget_climate_on_screen_right" bottom="@dimen/climate_widget_climate_on_screen_bottom"/>
        <Focus onTransition="false"/>
    </Variant>
    <Transitions>
        <Transition onEvent="show_page2" fromVariant="@id/base" toVariant="@id/climate_on_screen" duration="1200" interpolator="@android:anim/overshoot_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/climate_on_screen" toVariant="@id/base" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
    </Transitions>
</TaskPanel>
