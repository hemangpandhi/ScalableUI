<DecorPanel id="settings_shadow" defaultVariant="@id/hidden" role="@layout/phone_shadow_view" displayId="0">
    <Variant id="@+id/hidden">
        <Layer layer="12"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="@dimen/corner_radius"/>
        <Bounds left="@dimen/settings_shadow_hidden_left" top="@dimen/settings_shadow_hidden_top" right="@dimen/settings_shadow_hidden_right" bottom="@dimen/settings_shadow_hidden_bottom"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/opened">
        <Layer layer="12"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="@dimen/corner_radius"/>
        <Bounds left="@dimen/settings_shadow_opened_left" top="@dimen/settings_shadow_opened_top" right="@dimen/settings_shadow_opened_right" bottom="@dimen/settings_shadow_opened_bottom"/>
        <Focus onTransition="false"/>
    </Variant>
    <Transitions>
        <Transition onEvent="_System_OnHomeEvent" toVariant="@id/hidden" duration="300" interpolator="@android:anim/accelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=app_panel" toVariant="@id/hidden" duration="200" interpolator="@android:anim/linear_interpolator"/>
        <Transition onEvent="show_page2" toVariant="@id/hidden" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=settings_panel" fromVariant="@id/hidden" toVariant="@id/opened" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=app_panel" fromVariant="@id/opened" toVariant="@id/hidden" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/opened" toVariant="@id/hidden" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/opened" toVariant="@id/hidden" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="show_page2" fromVariant="@id/opened" toVariant="@id/hidden" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskCloseEvent" onEventTokens="panelId=settings_panel" fromVariant="@id/opened" toVariant="@id/hidden" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
    </Transitions>
</DecorPanel>
