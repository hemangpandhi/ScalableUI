<TaskPanel id="clock" defaultVariant="@id/base" role="@string/mockwidgets_time_widget_activity_componentName" displayId="0">
    <Variant id="@+id/base">
        <Layer layer="11"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Bounds left="@dimen/clock_base_left" top="@dimen/clock_base_top" right="@dimen/clock_base_right" bottom="@dimen/clock_base_bottom"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/clock_on_screen">
        <Layer layer="11"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Bounds left="@dimen/clock_clock_on_screen_left" top="@dimen/clock_clock_on_screen_top" right="@dimen/clock_clock_on_screen_right" bottom="@dimen/clock_clock_on_screen_bottom"/>
        <Focus onTransition="false"/>
    </Variant>
    <Transitions>
        <Transition onEvent="show_page2" fromVariant="@id/base" toVariant="@id/clock_on_screen" duration="994" interpolator="@android:anim/overshoot_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/clock_on_screen" toVariant="@id/base" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
    </Transitions>
</TaskPanel>
