<TaskPanel id="map_panel" defaultVariant="@id/opened" role="@string/mapsplaceholder_maps_placeholder_activity_componentName" displayId="0">
    <Variant id="@+id/opened">
        <Layer layer="4"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="@dimen/corner_radius"/>
        <Bounds left="@dimen/map_panel_opened_left" top="@dimen/map_panel_opened_top" right="@dimen/map_panel_opened_right" bottom="@dimen/map_panel_opened_bottom"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/expanded">
        <Layer layer="4"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="@dimen/corner_radius"/>
        <Bounds left="@dimen/map_panel_expanded_left" top="@dimen/map_panel_expanded_top" right="@dimen/map_panel_expanded_right" bottom="@dimen/map_panel_expanded_bottom"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/settings_stacked">
        <Layer layer="4"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="@dimen/corner_radius"/>
        <Bounds left="@dimen/map_panel_settings_stacked_left" top="@dimen/map_panel_settings_stacked_top" right="@dimen/map_panel_settings_stacked_right" bottom="@dimen/map_panel_settings_stacked_bottom"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/stacked">
        <Layer layer="4"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="@dimen/corner_radius"/>
        <Bounds left="@dimen/map_panel_stacked_left" top="@dimen/map_panel_stacked_top" right="@dimen/map_panel_stacked_right" bottom="@dimen/map_panel_stacked_bottom"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/page_2_shown">
        <Layer layer="4"/>
        <Visibility isVisible="false"/>
        <Alpha alpha="0.0"/>
        <Corner radius="@dimen/corner_radius"/>
        <Bounds left="@dimen/map_panel_page_2_shown_left" top="@dimen/map_panel_page_2_shown_top" right="@dimen/map_panel_page_2_shown_right" bottom="@dimen/map_panel_page_2_shown_bottom"/>
        <Focus onTransition="false"/>
    </Variant>
    <Transitions>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=map_panel" toVariant="@id/expanded" duration="900" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=app_panel" toVariant="@id/stacked" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=settings_panel" toVariant="@id/settings_stacked" duration="400" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/expanded" toVariant="@id/opened" duration="350" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" toVariant="@id/opened" duration="800" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="show_page2" fromVariant="@id/opened" toVariant="@id/page_2_shown" duration="300" interpolator="@android:anim/accelerate_interpolator"/>
        <Transition onEvent="show_page2" fromVariant="@id/expanded" toVariant="@id/page_2_shown" duration="300" interpolator="@android:anim/accelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=settings_panel" fromVariant="@id/page_2_shown" toVariant="@id/page_2_shown" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=media_panel" fromVariant="@id/page_2_shown" toVariant="@id/page_2_shown" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_OnHomeEvent" fromVariant="@id/page_2_shown" toVariant="@id/opened" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=panel_app_grid" fromVariant="@id/settings_stacked" toVariant="@id/opened" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskCloseEvent" onEventTokens="panelId=settings_panel" fromVariant="@id/settings_stacked" toVariant="@id/opened" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="show_page2" fromVariant="@id/settings_stacked" toVariant="@id/page_2_shown" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="show_page2" fromVariant="@id/stacked" toVariant="@id/page_2_shown" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
        <Transition onEvent="_System_TaskOpenEvent" onEventTokens="panelId=app_panel" fromVariant="@id/stacked" toVariant="@id/page_2_shown" duration="300" interpolator="@android:anim/accelerate_decelerate_interpolator"/>
    </Transitions>
</TaskPanel>
