<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="@drawable/floating_decor_bg"
    android:paddingHorizontal="24dp"
    android:orientation="horizontal"
    android:gravity="center">

    <ImageView
        android:id="@+id/nav_seat_heater_driver"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_nav_seat"
        android:scaleType="centerInside"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="8dp" />

    <LinearLayout
        android:id="@+id/hvac_driver_cluster"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/nav_hvac_driver_down"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_nav_minus"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp" />

        <TextView
            android:id="@+id/nav_hvac_driver_temp"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="22°"
            android:textSize="28sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageView
            android:id="@+id/nav_hvac_driver_up"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_nav_add"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp" />
    </LinearLayout>
</LinearLayout>
