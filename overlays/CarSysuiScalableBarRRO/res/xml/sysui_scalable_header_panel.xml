<?xml version="1.0" encoding="utf-8"?>
<!-- Header chrome DecorPanel — background and center divider only. -->
<DecorPanel
    id="sysui_scalable_header_panel"
    role="sysui_scalable_header_role"
    defaultVariant="@id/header_visible"
    controller="@xml/sysui_scalable_header_controller"
    displayId="0">

    <Variant id="@+id/header_visible">
        <Layer layer="20"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="@dimen/sysui_bar_corner_radius"/>
        <Bounds
            left="0dp"
            top="@dimen/sysui_scalable_header_top"
            right="@dimen/sysui_canvas_width"
            bottom="@dimen/sysui_scalable_header_bottom"/>
        <Focus onTransition="false"/>
    </Variant>

    <Variant id="@+id/header_hidden">
        <Layer layer="20"/>
        <Visibility isVisible="false"/>
        <Alpha alpha="0.0"/>
        <Corner radius="@dimen/sysui_bar_corner_radius"/>
        <Bounds
            left="0dp"
            top="-84dp"
            right="@dimen/sysui_canvas_width"
            bottom="0dp"/>
        <Focus onTransition="false"/>
    </Variant>

    <Transitions>
        <Transition onEvent="_System_OnHomeEvent" toVariant="@id/header_visible" duration="400" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="sysui_hide_header" fromVariant="@id/header_visible" toVariant="@id/header_hidden" duration="400" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="sysui_show_header" fromVariant="@id/header_hidden" toVariant="@id/header_visible" duration="400" interpolator="@anim/pleos_fluid_interpolator"/>
    </Transitions>
</DecorPanel>
