<?xml version="1.0" encoding="utf-8"?>
<!-- Driver zone: HVAC temperature + seat temperature controls (left header). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sysui_driver_zone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/sysui_bar_padding_horizontal"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/sysui_driver_zone_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sysui_zone_driver_label"
        android:textColor="@color/sysui_zone_label_driver"
        android:textSize="@dimen/sysui_zone_label_size"
        android:textAllCaps="true"
        android:layout_marginEnd="16dp" />

    <!-- HVAC cluster -->
    <ImageButton
        android:id="@+id/sysui_driver_hvac_down"
        android:layout_width="@dimen/sysui_hvac_touch_target"
        android:layout_height="@dimen/sysui_hvac_touch_target"
        android:src="@drawable/ic_sysui_hvac_down"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sysui_content_desc_hvac_down"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/sysui_driver_hvac_temp"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="22°"
        android:textColor="@color/sysui_bar_text_primary"
        android:textSize="@dimen/sysui_temp_text_size"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/sysui_driver_hvac_up"
        android:layout_width="@dimen/sysui_hvac_touch_target"
        android:layout_height="@dimen/sysui_hvac_touch_target"
        android:src="@drawable/ic_sysui_hvac_up"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sysui_content_desc_hvac_up"
        android:scaleType="centerInside"
        android:layout_marginEnd="24dp" />

    <!-- Seat temperature cluster -->
    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_sysui_seat_heat"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no" />

    <ImageButton
        android:id="@+id/sysui_driver_seat_down"
        android:layout_width="@dimen/sysui_hvac_touch_target"
        android:layout_height="@dimen/sysui_hvac_touch_target"
        android:src="@drawable/ic_sysui_hvac_down"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sysui_content_desc_seat_heat_down"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/sysui_driver_seat_temp"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/sysui_bar_text_secondary"
        android:textSize="20sp" />

    <ImageButton
        android:id="@+id/sysui_driver_seat_up"
        android:layout_width="@dimen/sysui_hvac_touch_target"
        android:layout_height="@dimen/sysui_hvac_touch_target"
        android:src="@drawable/ic_sysui_hvac_up"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sysui_content_desc_seat_heat_up"
        android:scaleType="centerInside" />

</LinearLayout>
