<TaskPanel id="camera_panel" defaultVariant="@id/hidden" role="com.android.car.mockwidgets/com.android.car.mockwidgets.CameraActivity" displayId="0">
    <Variant id="@+id/hidden">
        <Layer layer="4"/>
        <Visibility isVisible="false"/>
        <Alpha alpha="0.0"/>
        <Corner radius="48dp"/>
        <Bounds left="-1424dp" top="84dp" right="0dp" bottom="696dp"/>
        <Focus onTransition="false"/>
    </Variant>
    <Variant id="@+id/parking_scene">
        <Layer layer="4"/>
        <Visibility isVisible="true"/>
        <Alpha alpha="1.0"/>
        <Corner radius="48dp"/>
        <Bounds left="16dp" top="84dp" right="1424dp" bottom="696dp"/>
        <Focus onTransition="true"/>
    </Variant>
    <Transitions>
        <Transition onEvent="parking_scene" toVariant="@id/parking_scene" duration="600" interpolator="@anim/pleos_fluid_interpolator"/>
        <Transition onEvent="drive_scene" toVariant="@id/hidden" duration="600" interpolator="@anim/pleos_fluid_interpolator"/>
    </Transitions>
</TaskPanel>
