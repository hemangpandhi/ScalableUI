<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/floating_decor_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="48dp"
    android:paddingEnd="48dp">

    <!-- Home Button -->
    <ImageView
        android:id="@+id/nav_home"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_nav_home"
        android:scaleType="centerInside"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="8dp" />

    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>

    <!-- HVAC Cluster -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/nav_hvac_down"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_nav_minus"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp" />

        <TextView
            android:id="@+id/nav_hvac_temp"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="22°"
            android:textSize="28sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageView
            android:id="@+id/nav_hvac_up"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_nav_add"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp" />
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5"/>

    <!-- Seat Heater -->
    <ImageView
        android:id="@+id/nav_seat_heater"
        android:layout_width="80dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_nav_seat"
        android:scaleType="centerInside"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="8dp" />

    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>

    <!-- Media Cluster -->
    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical|end">
        
        <TextView
            android:id="@+id/nav_media_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Not Playing"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:gravity="end"
            android:paddingEnd="16dp" />

        <ImageView
            android:id="@+id/nav_media_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_media_play"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="16dp" />

        <ImageView
            android:id="@+id/nav_media_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_media_next"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>

    <!-- Apps Button -->
    <ImageView
        android:id="@+id/nav_apps"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_nav_apps"
        android:scaleType="centerInside"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="8dp" />

</LinearLayout>
