<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="@drawable/floating_decor_bg"
    android:paddingHorizontal="24dp"
    android:orientation="horizontal"
    android:gravity="center">

    <ImageView
        android:id="@+id/nav_home"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_nav_home"
        android:scaleType="centerInside"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="12dp" />

    <ImageView
        android:id="@+id/nav_hvac_fan"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_nav_fan"
        android:scaleType="centerInside"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="16dp"
        android:layout_marginStart="8dp" />

    <ImageView
        android:id="@+id/nav_quick_settings"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@android:drawable/ic_menu_preferences"
        android:scaleType="centerInside"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:layout_marginStart="8dp" />

    <ImageView
        android:id="@+id/nav_apps"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_nav_apps"
        android:scaleType="centerInside"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:layout_marginStart="8dp" />
</LinearLayout>
